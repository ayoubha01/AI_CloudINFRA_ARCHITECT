# Never copy local Node dependencies
**/node_modules
frontend/node_modules
server/node_modules

# Vite output/cache
frontend/dist
frontend/.vite

# Git
.git
.gitignore

# Environment files
.env
.env.*
frontend/.env
frontend/.env.*
server/.env
server/.env.*

# Logs
*.log
npm-debug.log*

# Terraform local cache/providers
**/.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE
.vscode
.idea
